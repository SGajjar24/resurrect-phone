<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top Divine Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#171310"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_diya"
            android:contentDescription="Diya" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/gold_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_diya"
            android:contentDescription="Diya" />
    </LinearLayout>

    <!-- Header Divider Line -->
    <View
        android:id="@+id/headerDivider"
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:layout_below="@id/headerLayout"
        android:background="#3D3027" />

    <!-- Bottom Persistent Dock ("Now Playing" Bar) -->
    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@drawable/dock_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Status Row: Diya / Note + Track Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/imgStatusIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_diya"
                android:layout_marginEnd="8dp"
                android:contentDescription="Playing Status" />

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/stopped"
                android:textColor="@color/text_gold"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="marquee" />
        </LinearLayout>

        <!-- Main Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Volume Down -->
            <Button
                android:id="@+id/btnVolDown"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:text="@string/vol_down"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/btn_vol_bg"
                android:layout_marginEnd="4dp" />

            <!-- Volume Up -->
            <Button
                android:id="@+id/btnVolUp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:text="@string/vol_up"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/btn_vol_bg"
                android:layout_marginEnd="6dp" />

            <!-- Play / Pause Button -->
            <Button
                android:id="@+id/btnPause"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2.2"
                android:text="@string/play_playback"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:background="@drawable/btn_play_bg"
                android:layout_marginEnd="4dp" />

            <!-- Stop Button -->
            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.6"
                android:text="@string/stop_playback"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/btn_stop_bg" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Aartis and Bhajans List -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerDivider"
        android:layout_above="@id/bottomDock"
        android:fillViewport="true"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="16dp">

            <!-- Section 1 Header: Nitya Bhakti -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_aartis"
                android:textColor="@color/gold_light"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <!-- 1. Hanuman Chalisa Card -->
            <RelativeLayout
                android:id="@+id/cardHanuman"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/card_selector"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgHanuman"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_hanuman"
                    android:contentDescription="Hanuman" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/imgHanuman"
                    android:layout_toStartOf="@+id/icActionHanuman"
                    android:layout_centerVertical="true"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hanuman_chalisa"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hanuman_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/icActionHanuman"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_ctrl_play"
                    android:contentDescription="Play" />
            </RelativeLayout>

            <!-- 2. Ganeshji Aarti Card -->
            <RelativeLayout
                android:id="@+id/cardGanesh"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/card_selector"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgGanesh"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_ganesh"
                    android:contentDescription="Ganesh" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/imgGanesh"
                    android:layout_toStartOf="@+id/icActionGanesh"
                    android:layout_centerVertical="true"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ganesh_aarti"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ganesh_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/icActionGanesh"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_ctrl_play"
                    android:contentDescription="Play" />
            </RelativeLayout>

            <!-- 3. Shivji Aarti Card -->
            <RelativeLayout
                android:id="@+id/cardShiv"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/card_selector"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgShiv"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_shiv"
                    android:contentDescription="Shiv" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/imgShiv"
                    android:layout_toStartOf="@+id/icActionShiv"
                    android:layout_centerVertical="true"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/shiv_aarti"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/shiv_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/icActionShiv"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_ctrl_play"
                    android:contentDescription="Play" />
            </RelativeLayout>

            <!-- 4. Krishna Bhajan Card -->
            <RelativeLayout
                android:id="@+id/cardKrishna"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/card_selector"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgKrishna"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_krishna"
                    android:contentDescription="Krishna" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/imgKrishna"
                    android:layout_toStartOf="@+id/icActionKrishna"
                    android:layout_centerVertical="true"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/krishna_bhajan"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/krishna_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/icActionKrishna"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_ctrl_play"
                    android:contentDescription="Play" />
            </RelativeLayout>

            <!-- 5. Amba Ma Aarti Card -->
            <RelativeLayout
                android:id="@+id/cardAmba"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/card_selector"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgAmba"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_amba"
                    android:contentDescription="Amba" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/imgAmba"
                    android:layout_toStartOf="@+id/icActionAmba"
                    android:layout_centerVertical="true"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/amba_aarti"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/amba_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/icActionAmba"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_ctrl_play"
                    android:contentDescription="Play" />
            </RelativeLayout>

            <!-- 6. Dada Bhagwan Aarti Card -->
            <RelativeLayout
                android:id="@+id/cardDada"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/card_selector"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgDada"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_dada"
                    android:contentDescription="Dada Bhagwan" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/imgDada"
                    android:layout_toStartOf="@+id/icActionDada"
                    android:layout_centerVertical="true"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dada_aarti"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dada_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/icActionDada"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_ctrl_play"
                    android:contentDescription="Play" />
            </RelativeLayout>

            <!-- 7. Vishnu / Jagdish Aarti Card -->
            <RelativeLayout
                android:id="@+id/cardJagdish"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/card_selector"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="14dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgJagdish"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_jagdish"
                    android:contentDescription="Vishnu" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/imgJagdish"
                    android:layout_toStartOf="@+id/icActionJagdish"
                    android:layout_centerVertical="true"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/jagdish_aarti"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/jagdish_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/icActionJagdish"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_ctrl_play"
                    android:contentDescription="Play" />
            </RelativeLayout>

            <!-- Section 2 Header: Online & Radio -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_online"
                android:textColor="@color/gold_light"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <!-- YouTube Bhajans Card -->
            <RelativeLayout
                android:id="@+id/cardNewPipe"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/card_selector"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgNewPipe"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_youtube"
                    android:contentDescription="YouTube" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/imgNewPipe"
                    android:layout_toStartOf="@+id/tagOnline"
                    android:layout_centerVertical="true"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/youtube_bhajan"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/youtube_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tagOnline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="@string/tag_online"
                    android:textColor="@color/tag_online_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/badge_online"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
            </RelativeLayout>

            <!-- FM Radio Card -->
            <RelativeLayout
                android:id="@+id/cardFmRadio"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/card_selector"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgRadio"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_radio"
                    android:contentDescription="FM Radio" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/imgRadio"
                    android:layout_toStartOf="@+id/tagOffline"
                    android:layout_centerVertical="true"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fm_radio"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fm_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tagOffline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="@string/tag_offline"
                    android:textColor="@color/tag_offline_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/badge_offline"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
            </RelativeLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
